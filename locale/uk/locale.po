msgid "plugins.generic.indexingReadiness.name"
msgstr "Готовність до індексування"

msgid "plugins.generic.indexingReadiness.description"
msgstr "Додає до розділу «Налаштування → Розповсюдження» вкладку з аналізом усіх опублікованих статей окремо для Google Scholar, ResearchGate, агрегаторів на основі Crossref (OpenAlex, Semantic Scholar, Dimensions) і систем OAI-PMH (BASE, OpenAIRE, DOAJ). Знаходить для порожніх полів метаданих значення, надруковані в PDF статті (анотації, ключові слова, список літератури, сторінки, ORCID, email, місце роботи) або наявні в реєстрах ORCID і ROR, і записує їх лише після підтвердження редактора, з історією змін і поверненням попереднього стану."

msgid "plugins.generic.indexingReadiness.tab"
msgstr "Готовність до індексування"

msgid "plugins.generic.indexingReadiness.loading"
msgstr "Завантаження даних про статті…"

msgid "plugins.generic.indexingReadiness.skip.filled"
msgstr "поле вже заповнено, наявне значення не змінюється"

msgid "plugins.generic.indexingReadiness.skip.empty"
msgstr "порожнє значення"

msgid "plugins.generic.indexingReadiness.skip.invalid"
msgstr "некоректне значення"

msgid "plugins.generic.indexingReadiness.skip.notFound"
msgstr "автора чи афіліацію не знайдено"

msgid "plugins.generic.indexingReadiness.skip.rorNotLocal"
msgstr "цього ROR немає в локальному реєстрі ROR вашої OJS"

msgid "plugins.generic.indexingReadiness.skip.unknown"
msgstr "невідома операція"

msgid "plugins.generic.indexingReadiness.skip.locale"
msgstr "мову «{$locale}» не ввімкнено для метаданих журналу"

msgid "plugins.generic.indexingReadiness.error.logEntryNotFound"
msgstr "Запис журналу змін не знайдено."

msgid "plugins.generic.indexingReadiness.error.alreadyRolledBack"
msgstr "Ці зміни вже скасовано."

msgid "plugins.generic.indexingReadiness.error.notFound"
msgstr "Опубліковану статтю не знайдено."

msgid "plugins.generic.indexingReadiness.error.server"
msgstr "Помилка сервера: {$message}"

msgid "plugins.generic.indexingReadiness.error.csrf"
msgstr "Недійсний токен безпеки. Оновіть сторінку."
